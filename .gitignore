# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/
/.pytest_cache/
data-service/.pytest_cache/
data-service/.mypy_cache/
data-service/.ruff_cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# runtime cache
.cache/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# database
*.db
*.db-journal
*.db.backup*

# python data service
data-service/.next/
data-service/.cache/
data-service/__pycache__/
*.pid
*.log

# temporary and test files at the repository root
/test-*.py
/test_*.py
/debug-*.py
/debug_*.py
/configure-*.py
*.tmp

# IDE and system files
.vscode/
.idea/
.DS_Store

# temporary directories
.agents/
.superpowers/
.env-backups/
.claude/

/src/generated/prisma
