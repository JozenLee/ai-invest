// 知识图谱市场数据增强 - 演示脚本
// 展示如何使用新的市场数据服务和投资信号功能

import { graphService } from '@/lib/services/graph.service'
import { graphMarketDataService } from '@/lib/services/graph-market-data.service'
import {
  evaluateInvestmentSignals,
  generateInvestmentSummary,
} from '@/lib/config/ai-compute-investment-rules'

async function demo() {
  console.log('========================================')
  console.log('知识图谱市场数据增强 - 演示')
  console.log('========================================\n')

  // 1. 获取AI算力硬件相关节点
  console.log('1️⃣  获取AI算力硬件节点...\n')

  const aiComputeTypes = [
    'chip_design',
    'memory',
    'server',
    'cooling',
    'optical_module',
  ]

  const allNodes = await graphService.getNodes()
  const aiNodes = allNodes.filter(node => aiComputeTypes.includes(node.type))

  console.log(`找到 ${aiNodes.length} 个AI算力硬件节点\n`)

  // 2. 选择一个节点进行演示
  const demoNode = aiNodes.find(n => n.type === 'chip_design') || aiNodes[0]

  if (!demoNode) {
    console.log('❌ 未找到演示节点')
    return
  }

  console.log(`2️⃣  演示节点: ${demoNode.name} (${demoNode.type})\n`)

  // 3. 获取市场数据增强
  console.log('3️⃣  获取市场数据增强...\n')

  const enhancedNode = await graphMarketDataService.enhanceNode(demoNode)
  const marketData = enhancedNode.marketData

  if (!marketData) {
    console.log('⚠️  暂无市场数据\n')
    return
  }

  // 4. 展示行业指数表现
  if (marketData.indexPerformance) {
    console.log('📊 行业指数表现:')
    console.log(`   指数: ${marketData.indexPerformance.name}`)
    console.log(`   1日涨跌: ${marketData.indexPerformance.changePct1d?.toFixed(2)}%`)
    console.log(`   5日涨跌: ${marketData.indexPerformance.changePct5d?.toFixed(2)}%`)
    console.log(`   30日涨跌: ${marketData.indexPerformance.changePct30d?.toFixed(2)}%\n`)
  }

  // 5. 展示ETF跟踪数据
  if (marketData.etfTracking && marketData.etfTracking.length > 0) {
    console.log('💰 跟踪ETF:')
    marketData.etfTracking.forEach(etf => {
      console.log(`   ${etf.name} (${etf.ticker})`)
      console.log(`   - 5日涨跌: ${etf.changePct5d?.toFixed(2)}%`)
      console.log(`   - 溢折价率: ${etf.premium?.toFixed(2)}%`)
      console.log(`   - 5日资金流入: ${etf.inflow5d?.toFixed(2)}亿\n`)
    })
  }

  // 6. 展示资金流向
  if (marketData.capitalFlow) {
    console.log('💸 资金流向:')
    console.log(`   主力净流入(5日): ${(marketData.capitalFlow.mainForceNet5d || 0) / 10000}亿`)
    console.log(`   资金情绪: ${marketData.capitalFlow.sentiment}`)
    if (marketData.capitalFlow.consecutiveDays) {
      console.log(`   连续${Math.abs(marketData.capitalFlow.consecutiveDays)}日${
        marketData.capitalFlow.consecutiveDays > 0 ? '流入' : '流出'
      }`)
    }
    console.log('')
  }

  // 7. 展示新闻热度
  if (marketData.newsHeat) {
    console.log('📰 新闻热度:')
    console.log(`   7日新闻数: ${marketData.newsHeat.count7d}`)
    console.log(`   30日新闻数: ${marketData.newsHeat.count30d}`)
    console.log(`   市场情绪: ${marketData.newsHeat.sentimentLabel || '未知'}`)
    console.log(`   是否热点: ${marketData.newsHeat.trending ? '是 🔥' : '否'}`)
    if (marketData.newsHeat.topKeywords && marketData.newsHeat.topKeywords.length > 0) {
      console.log(`   热词: ${marketData.newsHeat.topKeywords.join(', ')}`)
    }
    console.log('')
  }

  // 8. 展示市场认知
  if (marketData.marketCognition) {
    console.log('👥 市场关注度:')
    console.log(`   机构关注度: ${marketData.marketCognition.institutionalAttention}/100`)
    console.log(`   散户关注度: ${marketData.marketCognition.retailAttention}/100\n`)
  }

  // 9. 展示AI算力指标
  if (marketData.aiComputeMetrics) {
    console.log('🎮 AI算力指标:')
    if (marketData.aiComputeMetrics.gpuSupplyTightness !== undefined) {
      console.log(`   GPU供应紧张度: ${marketData.aiComputeMetrics.gpuSupplyTightness}/100`)
    }
    if (marketData.aiComputeMetrics.hbmSupplyStatus) {
      console.log(`   HBM供应状态: ${marketData.aiComputeMetrics.hbmSupplyStatus}`)
    }
    if (marketData.aiComputeMetrics.nvidiaCycle) {
      console.log(`   NVIDIA产品周期: ${marketData.aiComputeMetrics.nvidiaCycle}`)
    }
    if (marketData.aiComputeMetrics.hyperscalerDemand) {
      console.log(`   云厂商需求: ${marketData.aiComputeMetrics.hyperscalerDemand}`)
    }
    console.log('')
  }

  // 10. 评估投资信号
  console.log('4️⃣  评估投资信号...\n')

  const signals = evaluateInvestmentSignals(marketData, demoNode.type)

  if (signals.length === 0) {
    console.log('📌 当前无明确投资信号\n')
  } else {
    console.log(`🎯 检测到 ${signals.length} 个投资信号:\n`)

    signals.forEach((sig, index) => {
      console.log(`${index + 1}. ${sig.signal.name}`)
      console.log(`   信号强度: ${(sig.score * 100).toFixed(0)}%`)
      console.log(`   风险等级: ${sig.signal.riskLevel}`)
      console.log(`   置信度: ${(sig.signal.confidence * 100).toFixed(0)}%`)
      console.log(`   触发条件: ${sig.triggeredConditions.join(', ')}`)
      console.log('')
    })

    // 11. 生成投资建议摘要
    console.log('5️⃣  投资建议摘要:\n')
    const summary = generateInvestmentSummary(signals)
    console.log(summary)
  }

  console.log('========================================')
  console.log('演示结束')
  console.log('========================================')
}

// 运行演示
demo().catch(console.error)

export { demo }
