# Neo4j Configuration
AI_PROVIDER=anthropic
CHATGPT_API_KEY=
CHATGPT_BASE_URL=https://api.openai.com/v1
CHATGPT_MODEL=gpt-5.6-luna

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

NEXT_JS_URL=http://localhost:3000
# PORTFOLIO_SYNC_SECRET=

# 仅在确认 ETFHolding 已导入正式来源数据后启用；默认关闭，避免使用种子模拟持仓。
# ETF_HOLDINGS_DATABASE_TRUSTED=true

# 企业发展趋势分析
ETF_HOLDINGS_CONCURRENCY=5
ETF_HOLDINGS_REQUEST_TIMEOUT_SECONDS=20
TUSHARE_HOLDINGS_TIMEOUT_SECONDS=12
ETF_HOLDINGS_REPORT_PERIODS=2
ETF_HOLDINGS_ALLOW_PCF=false
TUSHARE_MAX_CONCURRENCY=1
TUSHARE_BUSY_RETRIES=0
MARKET_ETF_FETCH_CONCURRENCY=1
COMPANY_ANALYSIS_CONCURRENCY=4
COMPANY_ANALYSIS_SELECTION_LIMIT=8
COMPANY_ANALYSIS_DATA_TIMEOUT_SECONDS=90
COMPANY_ANALYSIS_PROVIDER_TIMEOUT_SECONDS=20
COMPANY_ANALYSIS_PROVIDER_RETRIES=1
COMPANY_ANALYSIS_CACHE_TTL_SECONDS=900
COMPANY_ANALYSIS_AI_TIMEOUT_SECONDS=360
COMPANY_ANALYSIS_AI_REQUEST_TIMEOUT_SECONDS=180
COMPANY_ANALYSIS_AI_RETRIES=1
COMPANY_ANALYSIS_AI_MAX_TOKENS=2200
STOCK_PROVIDER_TIMEOUT_SECONDS=20
# 可选：安装 OpenBB 后启用国际股票行情/财报 fallback
OPENBB_ENABLED=true

# 市场分析：按产业和周期缓存完整结果，避免重复抓取和重复生成报告
MARKET_ANALYSIS_CACHE_TTL_SECONDS=900
MARKET_ANALYSIS_TIMEOUT_SECONDS=480
MARKET_ANALYSIS_SOURCE_TIMEOUT_SECONDS=120
MARKET_DATA_MODE_SOURCE_TIMEOUT_SECONDS=300
MARKET_ANALYSIS_AI_TIMEOUT_SECONDS=180
MARKET_ANALYSIS_AI_RETRIES=1

# Tushare Promax 配置（密钥只从本地环境变量读取，不要提交到仓库）
# 所有市场数据和后续 Tushare 接口统一使用该 HTTP 鉴权方式。
TUSHARE_API_URL=
TUSHARE_API_KEY=
TUSHARE_TRANSPORT=rest
TUSHARE_HTTP_URL=
TUSHARE_GATEWAY_TOKEN=
TUSHARE_VERIFY_SSL=true
TUSHARE_TIMEOUT_SECONDS=30
# 市场概览单个指数请求超时（秒），避免一个数据源拖垮首屏
TUSHARE_MARKET_TIMEOUT_SECONDS=8
