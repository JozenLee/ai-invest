# AI投资分析系统 - 环境变量配置模板
# 复制此文件为 .env 并填写实际值

# ==================== AI 服务配置 ====================
# Anthropic API Key（必需）
# 官方: https://console.anthropic.com/
# 第三方: https://apiclaude.cc
ANTHROPIC_API_KEY=your-api-key-here

# Anthropic API Base URL（可选，使用第三方 API 时配置）
# 官方: https://api.anthropic.com
# 第三方: https://apiclaude.cc
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Claude 模型版本
# 可选值: claude-opus-4-8, claude-sonnet-4-20250514, claude-haiku-3-5-20241022
CLAUDE_MODEL=claude-sonnet-4-20250514

# ==================== 数据库配置 ====================
DATABASE_URL=file:./prisma/dev.db

# ==================== 服务端口配置 ====================
# Python 数据服务端口
DATA_SERVICE_URL=http://localhost:8000
PYTHON_API_URL=http://localhost:8000

# Next.js 服务端口（可选）
# NEXT_PUBLIC_API_URL=http://localhost:3000

# ==================== 可选配置 ====================
# Redis 缓存（可选，未配置则使用内存缓存）
# REDIS_URL=redis://localhost:6379/0
# REDIS_PASSWORD=

# Tushare Token（可选，用于获取 A 股市场数据）
# 获取地址: https://tushare.pro/
# TUSHARE_TOKEN=

# ==================== 环境配置 ====================
# 环境标识: development, production
NODE_ENV=development

# 时区
TZ=Asia/Shanghai

# 日志级别: debug, info, warning, error
LOG_LEVEL=info
