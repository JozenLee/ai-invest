# AI投资分析系统 - 环境变量配置模板
# 复制此文件为 .env 并填写实际值

# ==================== AI 服务配置 ====================
# AI 提供商选择: claude 或 openai
AI_PROVIDER=claude

# Anthropic API Key（使用 Claude 时必需）
# 官方: https://console.anthropic.com/
# 第三方: https://apiclaude.cc
ANTHROPIC_API_KEY=your-api-key-here

# Anthropic API Base URL（可选，使用第三方 API 时配置）
# 官方: https://api.anthropic.com
# 第三方: https://apiclaude.cc
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Claude 模型版本
# 可选值: claude-opus-4-8, claude-sonnet-4-20250514, claude-haiku-3-5-20241022
CLAUDE_MODEL=claude-sonnet-4-20250514

# OpenAI API Key（使用 OpenAI 时必需）
# 官方: https://platform.openai.com/
# 第三方: 根据实际情况配置
OPENAI_API_KEY=your-openai-api-key-here

# OpenAI API Base URL（可选，使用第三方 API 时配置）
# 官方: https://api.openai.com/v1
# 第三方: 根据实际情况配置
OPENAI_BASE_URL=https://api.openai.com/v1

# OpenAI 模型版本
# 可选值: gpt-4o, gpt-4o-mini, gpt-4-turbo, gpt-3.5-turbo
OPENAI_MODEL=gpt-4o

# ChatGPT/OpenAI 兼容接口别名（企业分析支持 AI_PROVIDER=chatgpt）
CHATGPT_API_KEY=
CHATGPT_BASE_URL=https://api.openai.com/v1
CHATGPT_MODEL=gpt-5.6-luna

# ==================== 数据库配置 ====================
DATABASE_URL=file:./prisma/dev.db

# ==================== 服务端口配置 ====================
# Python 数据服务端口
DATA_SERVICE_URL=http://localhost:8000
PYTHON_API_URL=http://localhost:8000
NEXT_JS_URL=http://localhost:3000

# 持仓定时同步接口保护（Next.js 与 Python 数据服务需保持一致）
# PORTFOLIO_SYNC_SECRET=

# 仅在确认 ETFHolding 已导入正式来源数据后启用；默认关闭，避免使用种子模拟持仓。
# ETF_HOLDINGS_DATABASE_TRUSTED=true

# Next.js 服务端口（可选）
# NEXT_PUBLIC_API_URL=http://localhost:3000

# ==================== 可选配置 ====================
# 持仓邮件同步（163 邮箱请填写客户端授权码，不是登录密码）
PORTFOLIO_MAIL_PROTOCOL=pop3
PORTFOLIO_IMAP_HOST=imap.163.com
PORTFOLIO_IMAP_PORT=993
PORTFOLIO_POP3_HOST=pop.163.com
PORTFOLIO_POP3_PORT=995
PORTFOLIO_IMAP_USER=jozenlee@163.com
PORTFOLIO_IMAP_PASSWORD=

# Redis 缓存（可选，未配置则使用内存缓存）
# REDIS_URL=redis://localhost:6379/0
# REDIS_PASSWORD=

# Tushare Promax 配置（密钥只放在本地 .env，不要提交）
# TUSHARE_API_URL=
# TUSHARE_API_KEY=
# TUSHARE_VERIFY_SSL=true
# TUSHARE_TIMEOUT_SECONDS=30
# 市场概览单个指数请求超时（秒），避免一个数据源拖垮首屏
TUSHARE_MARKET_TIMEOUT_SECONDS=8

# 企业发展趋势分析
COMPANY_ANALYSIS_CONCURRENCY=4
COMPANY_ANALYSIS_PROVIDER_TIMEOUT_SECONDS=20
COMPANY_ANALYSIS_PROVIDER_RETRIES=1
COMPANY_ANALYSIS_CACHE_TTL_SECONDS=900
COMPANY_ANALYSIS_AI_TIMEOUT_SECONDS=360
COMPANY_ANALYSIS_AI_REQUEST_TIMEOUT_SECONDS=180
COMPANY_ANALYSIS_AI_RETRIES=1
COMPANY_ANALYSIS_AI_MAX_TOKENS=2200
STOCK_PROVIDER_TIMEOUT_SECONDS=20
# 可选：安装 OpenBB 后启用国际股票行情/财报 fallback
OPENBB_ENABLED=true

# 市场分析：按产业和周期缓存完整结果，避免重复抓取和重复生成报告
MARKET_ANALYSIS_CACHE_TTL_SECONDS=900
MARKET_ANALYSIS_TIMEOUT_SECONDS=480
MARKET_ANALYSIS_SOURCE_TIMEOUT_SECONDS=120
MARKET_ANALYSIS_AI_TIMEOUT_SECONDS=180
MARKET_ANALYSIS_AI_RETRIES=1

# ==================== 环境配置 ====================
# 环境标识: development, production
NODE_ENV=development

# 时区
TZ=Asia/Shanghai

# 日志级别: debug, info, warning, error
LOG_LEVEL=info

# ==================== Neo4j 图数据库配置 ====================
# Neo4j 连接配置
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password-here
NEO4J_DATABASE=neo4j

# ==================== AI 探索引擎配置 ====================
# Tavily Search API Key（必需，用于AI联网探索）
# 获取地址: https://tavily.com/
TAVILY_API_KEY=your-tavily-api-key-here
# Local xiaohongshu-mcp bridge
XHS_MCP_URL=http://127.0.0.1:18060
# Optional: AUTH_TOKEN configured when starting xiaohongshu-mcp
XHS_MCP_AUTH_TOKEN=
