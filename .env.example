# AI投资分析系统 - 环境变量配置模板
# 复制此文件为 .env 并填写实际值

# ==================== AI 服务配置 ====================
# AI 提供商选择: claude 或 openai
AI_PROVIDER=claude

# Anthropic API Key（使用 Claude 时必需）
# 官方: https://console.anthropic.com/
# 第三方: https://apiclaude.cc
ANTHROPIC_API_KEY=your-api-key-here

# Anthropic API Base URL（可选，使用第三方 API 时配置）
# 官方: https://api.anthropic.com
# 第三方: https://apiclaude.cc
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Claude 模型版本
# 可选值: claude-opus-4-8, claude-sonnet-4-20250514, claude-haiku-3-5-20241022
CLAUDE_MODEL=claude-sonnet-4-20250514

# OpenAI API Key（使用 OpenAI 时必需）
# 官方: https://platform.openai.com/
# 第三方: 根据实际情况配置
OPENAI_API_KEY=your-openai-api-key-here

# OpenAI API Base URL（可选，使用第三方 API 时配置）
# 官方: https://api.openai.com/v1
# 第三方: 根据实际情况配置
OPENAI_BASE_URL=https://api.openai.com/v1

# OpenAI 模型版本
# 可选值: gpt-4o, gpt-4o-mini, gpt-4-turbo, gpt-3.5-turbo
OPENAI_MODEL=gpt-4o

# ==================== 数据库配置 ====================
DATABASE_URL=file:./prisma/dev.db

# ==================== 服务端口配置 ====================
# Python 数据服务端口
DATA_SERVICE_URL=http://localhost:8000
PYTHON_API_URL=http://localhost:8000

# Next.js 服务端口（可选）
# NEXT_PUBLIC_API_URL=http://localhost:3000

# ==================== 可选配置 ====================
# Redis 缓存（可选，未配置则使用内存缓存）
# REDIS_URL=redis://localhost:6379/0
# REDIS_PASSWORD=

# Tushare Token（可选，用于获取 A 股市场数据）
# 获取地址: https://tushare.pro/
# TUSHARE_TOKEN=

# ==================== 环境配置 ====================
# 环境标识: development, production
NODE_ENV=development

# 时区
TZ=Asia/Shanghai

# 日志级别: debug, info, warning, error
LOG_LEVEL=info

# ==================== Neo4j 图数据库配置 ====================
# Neo4j 连接配置
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password-here
NEO4J_DATABASE=neo4j

# ==================== AI 探索引擎配置 ====================
# Tavily Search API Key（必需，用于AI联网探索）
# 获取地址: https://tavily.com/
TAVILY_API_KEY=your-tavily-api-key-here
